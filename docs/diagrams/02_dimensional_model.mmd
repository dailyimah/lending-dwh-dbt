flowchart LR
    %% Star schema, drawn by rule rather than by edge: the shared dimensions feed every fact;
    %% only the exceptions are drawn individually. Marts list the facts they read.

    subgraph SHARED[Dimensions used by every fact]
        direction TB
        DC[("dim_customer (SCD2)<br/>as borrower")]
        DD[("dim_date")]
        DLT[("dim_loan_type")]
        DP[("dim_partner")]
    end

    DMS[("dim_movement_status")]

    subgraph FACTS[Facts]
        direction TB
        FL["fact_loan<br/>1 row per loan"]
        FRS["fact_repayment_schedule<br/>1 row per expected installment"]
        FR["fact_repayment<br/>1 row per payment applied to an installment"]
        FF["fact_funding<br/>1 row per lender commitment"]
        FS["fact_loan_daily_snapshot<br/>1 row per active loan per day"]
    end

    subgraph MARTS[Marts]
        direction TB
        M360["mart_customer_360<br/>reads: all facts"]
        MCS["mart_credit_score_by_segment<br/>reads: customer_360"]
        MD["mart_delinquency<br/>reads: daily snapshot"]
        MLP["mart_loan_performance<br/>reads: loan, schedule, snapshot"]
    end

    SHARED ==> FACTS
    DC -. "as lender" .-> FF
    DMS --> FL
    FACTS ==> MARTS
